{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "新闻动态",
    "description": "公司新闻与动态"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "date"
    },
    "excerpt": {
      "type": "text"
    },
    "coverImage": {
      "type": "media",
      "allowedTypes": ["images"]
    },
    "blocks": {
      "type": "blocks"
    },
    "nextSlug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "published"
    }
  }
}
